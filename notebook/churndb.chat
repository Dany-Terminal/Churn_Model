              "output": "[{\"cellType\":\"code\",\"source\":\"import pandas as pd\\nimport numpy as np\",\"execution_count\":1,\"cell_id\":\"d8aeb476-a842-4de9-8535-68d417901adb\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"path_db='../churn_db/analytics_data.csv'\\ndf=pd.read_csv(path_db)\",\"execution_count\":2,\"cell_id\":\"58d22c96-6fad-46ab-b836-af8b7cb15a9e\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"df.head()\",\"execution_count\":3,\"cell_id\":\"a020cfc3-4571-486c-925f-1b8c27fb6372\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"df.info()\",\"execution_count\":4,\"cell_id\":\"67f48660-95d6-4649-8922-0561b9b34cac\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"## Feature Selection (Features to keep)\\nAge, Gender ,Country, Membership_Years, Cart_Abandonment_Rate, Days_Since_Last_Purchase, Customer_Service_Calls(Most imp), Email_Open_Rate(Imp), Lifetime_Value\",\"execution_count\":null,\"cell_id\":\"2b2dc46c-84b5-44f1-98fb-de065c0c8945\"},{\"cellType\":\"code\",\"source\":\"df.info()\",\"execution_count\":7,\"cell_id\":\"d6d1879c-d354-4c64-89b1-f9c54e806cf1\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"df['Churned'].value_counts()\",\"execution_count\":22,\"cell_id\":\"30c99024-9a82-488f-aa19-7a41a2e5ccb5\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"X = df[['Age', 'Gender', 'Country', 'Membership_Years',\\n        'Cart_Abandonment_Rate', 'Days_Since_Last_Purchase',\\n        'Customer_Service_Calls', 'Email_Open_Rate',\\n        'Lifetime_Value']]\\n\\ny = df['Churned']\",\"execution_count\":5,\"cell_id\":\"21f5f07f-eb46-4189-a3ec-c1d32fd29965\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"num_cols=['Age', 'Membership_Years',\\n        'Cart_Abandonment_Rate', 'Days_Since_Last_Purchase',\\n        'Customer_Service_Calls', 'Email_Open_Rate',\\n        'Lifetime_Value']\\ncat_cols=[ 'Gender', 'Country']\",\"execution_count\":6,\"cell_id\":\"58c36b1a-92c3-4c8d-9082-502dd7f17aa0\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"#Numerical Pipeline\\nfrom sklearn.pipeline import Pipeline\\nfrom sklearn.preprocessing import StandardScaler\\n\\nnum_pipeline= Pipeline(\\n    ['scaler',StandardScaler()]\\n)\",\"execution_count\":11,\"cell_id\":\"e13e99ec-b454-4d36-9b2d-a1f7fd1ca277\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"#categorical pipeline\\nfrom sklearn.preprocessing import OneHotEncoder\\ncat_pipeline= Pipeline(\\n    ['encoder', OneHotEncoder(handle_unknown='ignore')]\\n)\",\"execution_count\":14,\"cell_id\":\"09463517-4783-49d9-97b7-29a54ec56a30\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"#compbine using column Transformer\\n#Note, not used simple imputer cuz null value already handled in eda file\\nfrom sklearn.compose import ColumnTransformer\\n\\npreprocessor = ColumnTransformer(\\n    [\\n        ('num', num_pipeline, num_cols),\\n        ('cat', cat_pipeline, cat_cols)\\n    ]\\n)\",\"execution_count\":15,\"cell_id\":\"306c3fd4-453b-40c6-970f-d9a4651f8b18\",\"language\":\"python\"},{\"cellType\":\"markdown\",\"source\":\"## Choosing Model\\n\\nOur target variable is not (not churn/ churn) (0/1), which is binary classification\\n\\nModels that can theoritically work are: Logistic regression and tree based model\\n\\nHowever logistic regression wont work better in such complex data, still we will use it to show case\\n\\nAs for tree based model we will use models like Decision Tree, Random Forest Tree, Gradient Boosting and XG boost\",\"execution_count\":null,\"cell_id\":\"f02e6efe-00df-48a7-bbee-63ebc1b19889\"},{\"cellType\":\"code\",\"source\":\"from sklearn.model_selection import train_test_split\\n\\n#stratify split, cuz we have imbalance target variable\\nX_train,X_test,y_train,y_test=train_test_split(X,y,test_size=0.2,stratify=y)\",\"execution_count\":24,\"cell_id\":\"03b09cfe-8bb2-4413-becd-70582aa39f69\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"from sklearn.linear_model import LogisticRegression\\nfrom sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier\\nfrom sklearn.tree import DecisionTreeClassifier\\nfrom xgboost import XGBClassifier\\n\\nmodels={\\n    'logistic': LogisticRegression(),\\n    'rf' : RandomForestClassifier(),\\n    'dt' : DecisionTreeClassifier(),\\n    'xg' : XGBClassifier(use_label_encoder=False, eval_metric='logloss')\\n}\\n\",\"execution_count\":26,\"cell_id\":\"6103daf0-5465-4e1c-a918-8b8a7737e885\",\"language\":\"python\"},{\"cellType\":\"code\",\"source\":\"from sklearn.model_selection import cross_val_score\\n#Roc-AUC is good to check Imbalance dataset\\nfor name,model in models.items():\\n    pipe=Pipeline(\\n        [\\n            ('processing', preprocessor),\\n            ('model', models)\\n        ]\\n    )\\n    score = cross_val_score(pipe,X_train,y_train,cv=5,scoring='roc_auc')\\n    print(name, score.mean())\",\"execution_count\":30,\"cell_id\":\"5c3e298f-324d-4390-9da0-ba13ba1edb4a\",\"language\":\"python\"}]",
